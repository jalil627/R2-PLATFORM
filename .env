# Database (SQLite for local dev; switch to PostgreSQL for production)
DATABASE_URL="file:./dev.db?connection_limit=5&socket_timeout=30"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-in-production"
AUTH_SECRET="dev-auth-secret-change-in-production"

# Google OAuth (needed for Google login - get from Google Cloud Console)
# Get keys at: https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="77339502729-6gfc12i1dgbkkro31jgdl7am1liuu897.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

# S3-compatible storage (disabled - no credentials)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Email — REQUIRED for real emails (pick ONE, no domain needed for Gmail)
# Option A — Gmail (no domain, no DNS): use any Gmail account + an App Password:
#   1. Google Account → Security → 2-Step Verification → ON
#   2. Security → App passwords → create one for "Mail" → paste below.
#   3. Emails arrive FROM your Gmail address (500/day free, plenty to start).
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="yourshop@gmail.com"
EMAIL_SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
# Option B — Resend (needs a verified domain + DNS records):
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"
# Without either: password reset / notifications fall back to in-app only,

# Payment provider: Chargily Pay V2 (بريدي موب / eDahabia + CIB — بالدينار الجزائري)
# Create account at https://pay.chargily.com, then get Secret Key from Dashboard → Developers Corner
# Webhook endpoint registered: https://<your-domain>/api/webhooks/payment
PAYMENT_PROVIDER="chargily"
CHARGILY_SECRET_KEY="live_sk_zR9LTkm2o4mXOK8FC70xNv3IdGEehf1jcBae1krT"
CHARGILY_PUBLIC_KEY="live_pk_b7GAn50BwIEr5NZRNVu1Jzm8mKCNDJqQAAerEZ62"
CHARGILY_ENV="live"
CHARGILY_API_BASE=""
CHARGILY_PAYMENT_METHOD="edahabia"  # "edahabia" (بريدي موب) أو "cib"
CHARGILY_AMOUNT_SCALE="1"
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Platform
PLATFORM_NAME="سوق رقمي"
PLATFORM_URL="http://localhost:3000"
DEFAULT_CURRENCY="DZD"
PLATFORM_FEE_PERCENT="10"

# Admin bootstrap (run `npm run db:bootstrap-admin` once, then REMOVE both lines)
# ADMIN_EMAIL="owner@example.com"
# ADMIN_PASSWORD="choose-a-strong-password-min-8-chars"