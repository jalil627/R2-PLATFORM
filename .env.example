# ============================================================
# R2 PLATFORM — environment template
# Copy to .env and fill ONLY the services you actually use.
# Anything without credentials stays disabled in the UI
# (no fake checkouts, no simulated emails — ever).
# ============================================================

# --- App ---
PLATFORM_URL="http://localhost:3000"
PLATFORM_NAME="R2 - PLATFORM"
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="same-as-auth-secret"
DEFAULT_CURRENCY="DZD"
PLATFORM_FEE_PERCENT="10"

# --- Admin bootstrap (run `npm run db:bootstrap-admin` once, then REMOVE both lines) ---
# ADMIN_EMAIL="owner@example.com"
# ADMIN_PASSWORD="choose-a-strong-password-min-8-chars"

# --- Google OAuth (optional — login button hidden without these) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- DZD cards: Chargily Pay (CIB / EDAHABIA) ---
# Get keys at https://pay.chargily.com (test mode first).
# Without CHARGILY_SECRET_KEY, DZD checkout is unavailable (manual stays
# hidden unless ALLOW_MANUAL_PAYMENTS=true). Never commit real keys.
PAYMENT_PROVIDER="chargily"
CHARGILY_ENV="test"
CHARGILY_SECRET_KEY=""
CHARGILY_PUBLIC_KEY=""           # publishable key (safe for reference; never used for charging)
# CHARGILY_API_BASE=""          # override only for custom endpoints
CHARGILY_PAYMENT_METHOD="edahabia"
CHARGILY_AMOUNT_SCALE="1"

# --- USD cards: PayPal Checkout (Orders v2) ---
# Create a REST app at https://developer.paypal.com (sandbox first).
# Without these keys, USD card payment is hidden from checkout.
# PAYPAL_MODE="sandbox"          # sandbox | live
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""           # from the webhook you create in the PayPal dashboard (recommended)

# --- Creator payouts (operational notes — no keys exist for this) ---
# Algerian rails expose NO automatic-transfer API: Chargily Pay is inbound
# only (CIB/EDAHABIA collection settles to YOUR bank account), and BaridiMob
# / banks offer no third-party payout endpoint. The real flow is manual:
#  1. Creator declares a validated beneficiary (CCP / BaridiMob RIP / Bank RIB)
#     at /creator/earnings (min 500 DZD = BaridiMob floor, code-validated).
#  2. Admin executes the transfer from the platform's own account in the
#     BaridiMob / bank app, then records the real reference at
#     Admin → المسحوبات before confirming PAID (enforced by the API).
# No credentials for this flow belong in .env — never paste BaridiMob/bank
# passwords or OTPs anywhere in the codebase.

# --- Manual transfers (DISABLED by default — real gateways only) ---
# Manual CCP/wire is hidden from checkout unless you opt in:
# ALLOW_MANUAL_PAYMENTS="true"
# DZD via CCP / BaridiMob. Also editable from Admin → Settings.
# MANUAL_CCP_ACCOUNT=""
# MANUAL_CCP_HOLDER=""
# USD via wire/SWIFT to your Compte Devise. Also editable from Admin → Settings.
# MANUAL_USD_WIRE=""
# MANUAL_USD_HOLDER=""
# Incoming webhook shared secret for manual provider integrations.
# MANUAL_WEBHOOK_SECRET=""

# --- Email — REQUIRED for real emails (pick ONE, no domain needed for Gmail) ---
# Option A — Gmail (no domain, no DNS): use any Gmail account + an App Password:
#   1. Google Account → Security → 2-Step Verification → ON
#   2. Security → App passwords → create one for "Mail" → paste below.
#   3. Emails arrive FROM your Gmail address (500/day free, plenty to start).
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_USER="yourshop@gmail.com"
# EMAIL_SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
# Option B — Resend (needs a verified domain + DNS records):
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"
# Without either: password reset / notifications fall back to in-app only,
# and the admin email page refuses to send (no silent fake success).

# --- File storage (S3-compatible; local disk fallback when empty) ---
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL=""

# --- Misc secrets ---
FILE_SIGNING_SECRET="generate-a-long-random-string"
PAYMENT_SECRET_KEY="generate-a-long-random-string"
PAYMENT_WEBHOOK_SECRET="generate-a-long-random-string"

# --- Production checklist (before going live) ---
# 1. NEXTAUTH_URL + PLATFORM_URL = https://yourdomain (https required:
#    auth cookies are `Secure` in production and won't work over http).
#    The server REFUSES to boot in production on localhost/test config.
# 2. AUTH_SECRET = fresh 32+ byte random value (`openssl rand -base64 32`).
#    Rotating it invalidates ALL sessions (everyone must log in again).
# 3. CHARGILY_ENV="live" + live secret key (test keys = $0 money).
# 4. Chargily dashboard → Developers Corner webhook URL =
#    https://yourdomain/api/webhooks/payment
# 5. Email: Gmail App Password (no DNS) or Resend verified domain.
# 6. Google Console: add https://yourdomain/api/auth/callback/google.
# 7. Back up dev.db + storage/uploads on a schedule (see `npm run db:backup`).
# 8. (Escape hatch only) SKIP_ENV_VALIDATION="1" bypasses the boot check.
